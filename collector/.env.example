# Copy to collector/.env and fill in real values. collector/.env is git-ignored.
# Create API keys at https://www.okx.com/account/my-api

OKX_API_KEY=your-api-key-here
OKX_API_SECRET=your-api-secret-here
OKX_PASSPHRASE=your-passphrase-here
# 1 = demo trading, 0 = live trading
OKX_FLAG=1

# OANDA forex quotes: create a practice account, then generate a token under
# "Manage API Access" at https://www.oanda.com
OANDA_API_TOKEN=your-oanda-token-here
OANDA_ACCOUNT_ID=your-account-id-here
# practice or live
OANDA_ENV=practice
