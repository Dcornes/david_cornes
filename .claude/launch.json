{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/fastapi.exe",
      "runtimeArgs": ["dev", "backend/app/main.py", "--port", "8000"],
      "port": 8000
