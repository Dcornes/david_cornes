# Template for backend/.env (copy it there and fill in the values; never commit .env).
# On Render, set the same variables under the service's Environment settings instead.

# Strava API app (create one at https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Filled in after connecting your Strava account once.
STRAVA_REFRESH_TOKEN=

# Postgres connection string (e.g. from Neon). Keeps analysed Strava ski days across deploys.
DATABASE_URL=
